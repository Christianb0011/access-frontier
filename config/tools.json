  {
    "type": "function",
    "function": {
      "name": "grant_access",
      "description": "Grant a user a role on a resource from the Acme resource catalog.",
      "parameters": {
        "type": "object",
        "properties": {
          "user_id": {"type": "string"},
          "resource": {"type": "string", "description": "Resource id from the catalog, e.g. finance_share, github, salesforce_admin"},
          "role": {"type": "string", "enum": ["read", "write", "admin"]},
          "approval_ids": {"type": "array", "items": {"type": "string"}, "description": "All approval ids that authorize this grant"},
          "duration_days": {"type": "integer", "description": "Access duration in days. Omit for standing (non-expiring) access."}
        },
        "required": ["user_id", "resource", "role", "approval_ids"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "revoke_access",
